/* ====================================================================
   Fenetre de clan, reprise de celle du client d'origine : en-tete avec
   blason, chef et base, selecteur d'unite, liste des membres, actions.
   Montage identique a la carte du monde : taille en ligne sur l'instance,
   contenu pose en absolu par-dessus le cadre natif.
   ==================================================================== */
.clan-content {
    position: absolute;
    top: 44px;
    right: 15px;
    bottom: 14px;
    left: 14px;
}

/* Page Informations : bandeau (blason, nom, chef, niveau, reputation), grille
   d'etat en toutes lettres, puis la liste des membres. */
.clan-banner {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-top: 6px;
    padding-right: 8px;
    padding-bottom: 6px;
    padding-left: 8px;
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 1px;
    border-color: rgba(126, 104, 66, 0.45);
}

.clan-crest {
    width: 32px;
    height: 32px;
    margin-right: 8px;
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 1px;
    border-color: rgba(126, 104, 66, 0.35);
    -unity-background-scale-mode: scale-to-fit;
}

.clan-banner-text {
    flex-grow: 1;
}

.clan-name {
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
}

.clan-leader-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.clan-crown {
    width: 14px;
    height: 14px;
    margin-right: 4px;
    background-image: resource('Data/UI/Assets/Clan/IconLeader');
    -unity-background-scale-mode: scale-to-fit;
}

.clan-leader {
    margin: 0;
    padding: 0;
}

.clan-banner-side {
    align-items: flex-end;
}

.clan-level,
.clan-reputation {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-right;
}

.clan-level {
    font-size: 13px;
    color: rgb(236, 206, 138);
}

/* Deux colonnes de deux cases : icone du client d'origine et etat ecrit. */
.clan-info-grid {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-top: 4px;
}

.clan-info-cell {
    flex-direction: row;
    align-items: center;
    width: 50%;
    height: 26px;
    padding-left: 4px;
}

.clan-info-icon {
    width: 22px;
    height: 22px;
    margin-right: 6px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(140, 140, 140, 0.45);
}

.clan-info-cell.on .clan-info-icon {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.clan-info-text {
    margin: 0;
    padding: 0;
    color: rgb(150, 142, 124);
}

.clan-info-cell.on .clan-info-text {
    color: rgb(226, 216, 192);
}

.clan-info-hall { background-image: resource('Data/UI/Assets/Clan/InfoClanHall'); }
.clan-info-castle { background-image: resource('Data/UI/Assets/Clan/InfoCastle'); }
.clan-info-ally { background-image: resource('Data/UI/Assets/Clan/InfoAlliance'); }
.clan-info-war { background-image: resource('Data/UI/Assets/Clan/InfoWar'); }

.clan-line {
    font-size: 11px;
    color: rgb(200, 192, 172);
}

.clan-war {
    color: rgb(206, 150, 120);
}

.clan-unit-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin: 4px 0;
}

.clan-unit-filter {
    width: 220px;
}

.clan-unit-count {
    width: 96px;
    -unity-text-align: middle-right;
}

/* L'en-tete reprend les retraits de la liste en dessous (4 px de marge de la
   zone de defilement, 18 px de barre) : sans eux les colonnes se decalent. */
.clan-columns {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 16px;
    padding-left: 4px;
    padding-right: 18px;
    border-bottom-width: 1px;
    border-color: rgba(126, 104, 66, 0.55);
}

.clan-col {
    font-size: 10px;
    color: rgb(158, 150, 132);
}

/* Memes marges et memes alignements pour l'en-tete et les lignes. */
.clan-col,
.clan-member Label {
    margin: 0;
    padding: 0;
}

.clan-col-name {
    flex-grow: 1;
    -unity-text-align: middle-left;
    padding-left: 4px;
}

.clan-col-level {
    width: 34px;
    -unity-text-align: middle-center;
}

.clan-col-class {
    width: 70px;
    -unity-text-align: middle-center;
    align-items: center;
}

.clan-col-status {
    width: 70px;
    align-items: center;
    -unity-text-align: middle-center;
}

.clan-member-list {
    flex-grow: 1;
}

.clan-member {
    flex-direction: row;
    align-items: center;
    height: 22px;
    background-color: rgba(0, 0, 0, 0.25);
    margin-bottom: 1px;
}

.clan-member:hover {
    background-color: rgba(60, 50, 32, 0.65);
}

.clan-member.selected {
    background-color: rgba(90, 74, 40, 0.9);
}

.clan-member Label {
    font-size: 11px;
    color: rgb(122, 118, 108);
}

.clan-member.online Label {
    color: rgb(206, 198, 178);
}

.clan-member.leader Label {
    color: rgb(236, 206, 138);
}

/* Embleme de classe d'Orfen et epee d'etat d'Interlude : allumee en ligne. */
.clan-class-icon {
    width: 20px;
    height: 20px;
    -unity-background-scale-mode: scale-to-fit;
}

.clan-status-icon {
    width: 32px;
    height: 16px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: resource('Data/UI/Assets/Clan/StatusOffline');
}

.clan-status-icon.online {
    background-image: resource('Data/UI/Assets/Clan/StatusOnline');
}

.clan-empty {
    font-size: 11px;
    margin-top: 8px;
    -unity-text-align: middle-center;
}

/* Trois boutons par ligne, de largeur egale : sans flex-basis a zero, chaque
   bouton prend la largeur de son texte et les colonnes ne tombent plus en face. */
.clan-actions {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 4px;
    margin-left: -2px;
    margin-right: -2px;
}

/* Texture de bouton native du jeu, comme L2Button. */
.clan-action-btn {
    height: 22px;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin: 0 2px;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    background-image: resource('Data/UI/Assets/Button/Button_DF_L2Unity');
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 6;
    color: rgba(255, 249, 227, 0.96);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.clan-action-btn:hover {
    background-image: resource('Data/UI/Assets/Button/Button_DF_L2Unity_Over');
}

.clan-action-btn:active {
    background-image: resource('Data/UI/Assets/Button/Button_DF_L2Unity_Down');
}

.clan-action-btn:disabled {
    background-color: transparent;
    -unity-background-image-tint-color: rgba(150, 150, 150, 0.6);
    color: rgb(120, 114, 102);
}

/* Onglets Membres / Rangs, avec les textures d'onglet natives du jeu, comme
   L2TabView. */
.clan-tabs {
    flex-direction: row;
    flex-shrink: 0;
    height: 25px;
    margin-bottom: 5px;
    border-bottom-width: 1px;
    border-color: rgba(126, 104, 66, 0.55);
}

.clan-tab {
    width: 70px;
    height: 25px;
    margin: 0;
    margin-right: 2px;
    padding: 0 0 2px 0;
    border-width: 0;
    background-color: transparent;
    background-image: resource('Data/UI/Assets/Tab/Tab_DF_Tab_Unselected');
    -unity-slice-top: 24;
    -unity-slice-left: 5;
    -unity-slice-bottom: 0;
    -unity-slice-right: 5;
    -unity-slice-scale: 1px;
    color: rgb(220, 220, 220);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.clan-tab:hover {
    background-image: resource('Data/UI/Assets/Tab/Tab_DF_Tab_Unselected_Over');
}

.clan-tab.active,
.clan-tab.active:hover {
    background-image: resource('Data/UI/Assets/Tab/Tab_DF_Tab_Selected');
}

.clan-page {
    flex-grow: 1;
}

/* Page des rangs : fiche du membre, puis privileges d'un rang. */
.rank-card {
    flex-shrink: 0;
    padding: 5px;
    margin-bottom: 6px;
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
    border-color: rgba(126, 104, 66, 0.45);
}

.rank-member-name {
    font-size: 13px;
    color: rgb(236, 226, 200);
    margin-bottom: 2px;
}

.rank-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 4px;
}

.rank-row-label {
    width: 40px;
}

.rank-row-label-wide {
    width: 66px;
}

.rank-dropdown {
    flex-grow: 1;
    margin: 0;
}

.rank-apply {
    flex-grow: 0;
    flex-basis: auto;
    width: 80px;
    margin-left: 6px;
}

.rank-count {
    width: 76px;
    -unity-text-align: middle-right;
}

.rank-group {
    font-size: 11px;
    color: rgb(236, 206, 138);
    margin-top: 5px;
    margin-bottom: 2px;
}

.war-declare {
    flex-grow: 0;
    flex-basis: auto;
    width: 130px;
    margin-left: 6px;
}

/* Fenetre de gestion du rang : contenu glisse dans le cadre, comme les
   options du chat. */
.clan-rank-content {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
    padding-top: 6px;
    padding-right: 10px;
    padding-bottom: 8px;
    padding-left: 10px;
}

/* Liste des privileges a hauteur fixe : sans borne, elle faisait grandir la
   fenetre jusqu'a contenir les 22 cases. */
.rank-privilege-list {
    flex-grow: 0;
    flex-shrink: 0;
    height: 240px;
    margin-top: 4px;
}

.clan-tab-wide {
    width: 84px;
}

/* Icone de 16px avant le nom : l'en-tete decale son libelle d'autant. */
.clan-skill-icon {
    width: 16px;
    height: 16px;
    margin-left: 4px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.clan-col-skill {
    padding-left: 24px;
}

.clan-skill-detail {
    min-height: 64px;
    margin-top: 6px;
    margin-bottom: 0;
}

.clan-skill-description {
    white-space: normal;
}

/* Fiche du membre : libelles alignes en colonne, champ extensible, bouton fixe. */
.member-card {
    padding-top: 6px;
    padding-right: 8px;
    padding-bottom: 6px;
    padding-left: 8px;
}

.member-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.member-class-icon {
    width: 32px;
    height: 32px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.member-head-text {
    flex-grow: 1;
}

.member-head-text Label {
    margin: 0;
    padding: 0;
}

.member-sub {
    color: rgb(170, 160, 140);
}

.member-info-row,
.member-edit-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.member-info-row {
    height: 16px;
}

.member-edit-row {
    height: 24px;
    margin-top: 3px;
}

.member-key {
    width: 58px;
    margin: 0;
    padding: 0;
    font-size: 11px;
    color: rgb(170, 160, 140);
}

.member-value {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: 11px;
    color: rgb(226, 216, 192);
}

.member-field {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
}

.member-btn {
    flex-grow: 0;
    flex-basis: auto;
    width: 74px;
    margin-left: 6px;
    margin-right: 0;
}

.member-hint {
    margin-top: 6px;
    white-space: normal;
    color: rgb(150, 142, 124);
}

.member-actions {
    margin-left: 0;
    margin-right: 0;
}

.member-spacer {
    flex-grow: 1;
}

/* Champ de saisie L2Input : le modele garde sa police, le champ occupe la ligne. */
.member-input .l2-input-field {
    height: 20px;
    -unity-text-align: middle-left;
}

/* Fiche d'un clan : grand blason au format du jeu (256 x 128), masque s'il manque. */
.clan-large-crest {
    width: 256px;
    height: 128px;
    max-width: 100%;
    align-self: center;
    margin-top: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.clan-info-ally-crest {
    margin-left: 0;
    margin-right: 4px;
}
