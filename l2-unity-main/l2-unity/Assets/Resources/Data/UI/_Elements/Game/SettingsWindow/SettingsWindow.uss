/* ====================================================================
   Fenêtre de réglages — feuille de style.
   Structure : SettingsWindowBody.uxml (barre d'onglets + 3 panneaux +
   pied de page) est injecté dans le cadre WindowTemplate par
   SettingsWindow.cs. Pour ajuster l'APPARENCE, tout se règle ici ;
   pour ajuster le CONTENU (lignes/contrôles), voir SettingsWindowBody.uxml.
   ==================================================================== */

/* Conteneur global : colonne (onglets en haut, contenu au milieu, pied en bas) */
.settings-window-content {
    flex-grow: 1;
    flex-direction: column;
    padding-top: 8px;
    padding-right: 14px;
    padding-bottom: 8px;
    padding-left: 14px;
}

/* ---------- Barre d'onglets ---------- */
.settings-tabs {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 0;
    margin-bottom: -1px;
    margin-left: 4px;
    padding: 0;
    height: 26px;
}

.settings-tab-btn {
    width: 70px;
    height: 25px;
    margin-right: 3px;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    background-image: resource('Data/UI/Assets/Tab/Tab_DF_Tab_Unselected');
    -unity-slice-top: 24;
    -unity-slice-left: 5;
    -unity-slice-bottom: 0;
    -unity-slice-right: 5;
    -unity-slice-scale: 1px;
    color: rgb(200, 200, 200);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.settings-tab-btn:hover {
    background-image: resource('Data/UI/Assets/Tab/Tab_DF_Tab_Unselected_Over');
}

.settings-tab-btn.active {
    background-image: resource('Data/UI/Assets/Tab/Tab_DF_Tab_Selected');
    color: rgb(255, 255, 255);
}

/* ---------- Zone de contenu (boite + panneaux) ----------
   Conteneur simple en flex-grow:1 (PAS un ScrollView : celui-ci se
   redimensionnait sur son contenu et donnait un effet "fenetre dans la
   fenetre" sur les onglets courts). Le fond Tab_DF_bg remplit donc toujours
   toute la zone, quel que soit le nombre de lignes de l'onglet actif. */
.settings-content-box {
    flex-grow: 1;
    /* Plancher de hauteur : garantit que la boite remplit la zone meme si la
       chaine flex (qui traverse plusieurs GroupBox/TemplateContainer) ne se
       propage pas. Sans ca, la boite epouse ses lignes et son bord bas dessine
       un trait au milieu de la fenetre sur les onglets courts (Jeu/Audio), avec
       le fond sombre de la fenetre visible en dessous. Fenetre = 500px de haut
       moins l'entete/les onglets/le pied => ~375px disponibles ici (agrandie de
       430 a 500 pour loger les touches reassignables sur 2 colonnes). */
    min-height: 375px;
    flex-direction: column;
    overflow: hidden;
    background-image: resource('Data/UI/Assets/Tab/Tab_DF_bg');
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    padding-top: 10px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
}

.settings-panel {
    flex-grow: 1;
    flex-direction: column;
}

/* ---------- Ligne de réglage (label + contrôle) ---------- */
.settings-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    margin-top: 0;
    margin-bottom: 8px;
    padding: 0;
}

.settings-row-label {
    width: 110px;
    flex-shrink: 0;
    font-size: 12px;
}

.settings-row-label-wide {
    width: 160px;
    white-space: normal;
}

/* Lignes prévues mais pas encore branchées : grisées */
.settings-row-disabled {
    opacity: 0.45;
}

/* ---------- Menus déroulants ---------- */
.settings-dropdown {
    width: 130px;
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 0;
}

/* ---------- Cases à cocher ---------- */
.settings-toggle {
    margin: 0;
}

.settings-toggle .unity-toggle__input {
    margin: 0;
}

.settings-toggle .unity-toggle__checkmark {
    width: 18px;
    height: 18px;
    background-color: rgba(0, 0, 0, 0.4);
    background-image: resource('Data/UI/Assets/Quest/CheckBoxQuest');
    -unity-background-scale-mode: scale-to-fit;
    border-width: 0;
}

.settings-toggle:checked .unity-toggle__checkmark {
    background-image: resource('Data/UI/Assets/Quest/CheckBox_checked');
}

/* ---------- Curseurs de volume ---------- */
.l2-slider {
    flex-grow: 1;
    height: 16px;
    margin-top: 0;
    margin-right: 5px;
    margin-bottom: 0;
    margin-left: 0;
}

.l2-slider .unity-base-slider__tracker {
    background-color: transparent;
    background-image: resource('Data/UI/Assets/Scrollbar/HorizontalSliderBarCenter');
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-scale: 1px;
    top: 4px;
    height: 8px;
    border-width: 0;
}

.l2-slider .unity-base-slider__tracker:hover:enabled {
    background-color: transparent;
    background-image: resource('Data/UI/Assets/Scrollbar/HorizontalSliderBarCenter_Over');
}

.l2-slider .unity-base-slider__drag-container {
    background-color: transparent;
    border-width: 0;
    padding: 0;
}

.l2-slider .unity-base-slider__dragger {
    width: 12px;
    height: 16px;
    margin-left: -6px;
    background-color: transparent;
    background-image: resource('Data/UI/Assets/Scrollbar/SliderBar');
    -unity-slice-top: 0;
    -unity-slice-left: 2;
    -unity-slice-bottom: 0;
    -unity-slice-right: 2;
    -unity-slice-scale: 1px;
    border-width: 0;
}

.l2-slider .unity-base-slider__dragger:hover:enabled {
    background-color: transparent;
}

.l2-slider:active .unity-base-slider__tracker {
    background-image: resource('Data/UI/Assets/Scrollbar/HorizontalSliderBarCenterOn');
}

/* ---------- Section "Touches" (onglet Jeu) ---------- */
.settings-section-label {
    font-size: 12px;
    -unity-font-style: bold;
    margin-top: 2px;
    margin-bottom: 6px;
    flex-shrink: 0;
}

.settings-keybind-columns {
    flex-direction: row;
    flex-grow: 1;
}

.settings-keybind-column {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 16px;
}

.settings-keybind-column:last-child {
    margin-right: 0;
}

.settings-keybind-row {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
    margin-bottom: 6px;
    padding: 0;
}

.settings-keybind-label {
    width: 105px;
    flex-shrink: 0;
    font-size: 12px;
}

.settings-keybind-btn {
    width: 75px;
    height: 22px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    background-image: resource('Data/UI/Assets/Button/Button_DF');
    -unity-slice-left: 15;
    -unity-slice-top: 15;
    -unity-slice-right: 15;
    -unity-slice-bottom: 15;
    -unity-slice-scale: 1px;
    color: rgba(255, 249, 227, 0.96);
    font-size: 11px;
    -unity-text-align: middle-center;
    -unity-font-definition: resource('Data/UI/Assets/Font/tahoma Light');
}

.settings-keybind-btn:hover {
    background-image: resource('Data/UI/Assets/Button/Button_DF_Over');
}

.settings-keybind-btn:active {
    background-image: resource('Data/UI/Assets/Button/Button_DF_Down');
}

.settings-keybind-btn-listening {
    color: rgb(255, 210, 90);
}

.settings-keybind-footer {
    flex-direction: row;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 6px;
    padding: 0;
}

.settings-keybind-reset-btn {
    width: 130px;
}

/* ---------- Pied de fenêtre ---------- */
.settings-footer {
    flex-direction: row;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 8px;
    padding: 0;
}

/* Boutons de pied : fond porte directement par le Button (le texte reste
   visible), pas de calque enfant qui le masquerait. */
.settings-footer-btn {
    width: 92px;
    height: 28px;
    margin-left: 5px;
    margin-right: 5px;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    background-image: resource('Data/UI/Assets/Button/Button_DF');
    -unity-slice-left: 15;
    -unity-slice-top: 15;
    -unity-slice-right: 15;
    -unity-slice-bottom: 15;
    -unity-slice-scale: 1px;
    color: rgba(255, 249, 227, 0.96);
    font-size: 12px;
    -unity-text-align: middle-center;
    -unity-font-definition: resource('Data/UI/Assets/Font/tahoma Light');
}

.settings-footer-btn:hover {
    background-image: resource('Data/UI/Assets/Button/Button_DF_Over');
}

.settings-footer-btn:active {
    background-image: resource('Data/UI/Assets/Button/Button_DF_Down');
}

.settings-footer-btn:active:hover {
    background-image: resource('Data/UI/Assets/Button/Button_DF_Down');
}
